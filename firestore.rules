rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules → Publish.
// Anyone who opens the app signs in anonymously and may read and edit the
// band's songs and setlist; nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /songs/{songId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.size() < 100 * 1024;
      allow delete: if request.auth != null;
    }
    match /meta/setlist {
      allow read, write: if request.auth != null;
    }
  }
}
